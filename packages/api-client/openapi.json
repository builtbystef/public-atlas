        "summary": "Approve Review Kind",
        "description": "Approve every open item of the kind. A `new_type` kind gives its bodies the type named,\nby default the suggested type as a type name; the type must exist.",
        "operationId": "review-approve_review_kind",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/KindApproveInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
