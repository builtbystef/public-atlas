  "components": {
    "schemas": {
      "AdministrativeLevelInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Name"
          },
          "rank": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Rank"
