{
  "openapi": "3.1.0",
  "info": {
    "title": "Public Atlas API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Read Health",
        "description": "Liveness: the process is up.",
        "operationId": "health-read_health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/db": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Read Health Db",
        "description": "Readiness: the database answers.",
        "operationId": "health-read_health_db",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/health/storage": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Read Health Storage",
        "description": "Readiness: the object store answers and the bucket exists.",
        "operationId": "health-read_health_storage",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/countries": {
      "get": {
        "tags": [
          "countries"
        ],
        "summary": "List Countries",
        "operationId": "countries-list_countries",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CountrySettingsInput"
                  },
                  "type": "array",
                  "title": "Response Countries-List Countries"
                }
              }
            }
          }
        }
      }
    },
    "/countries/{country_code}": {
      "get": {
        "tags": [
          "countries"
        ],
        "summary": "Read Country",
        "description": "The country's settings, its administrative levels and how it uses each type.",
        "operationId": "countries-read_country",
        "parameters": [
          {
            "name": "country_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Country Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryOutput"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "countries"
        ],
        "summary": "Put Country Settings",
        "description": "Create the country or change its name and naming rules.",
        "operationId": "countries-put_country_settings",
        "parameters": [
          {
            "name": "country_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Country Code"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CountrySettingsInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountrySettingsInput"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/countries/{country_code}/administrative-levels/{name}": {
      "put": {
        "tags": [
          "countries"
        ],
        "summary": "Put Administrative Level",
        "description": "Create or change a level. Its types must be ones the country uses.",
        "operationId": "countries-put_administrative_level",
        "parameters": [
          {
            "name": "country_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Country Code"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdministrativeLevelInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdministrativeLevelInput"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "countries"
        ],
        "summary": "Delete Administrative Level",
        "description": "Refused while a place sits at the level.",
        "operationId": "countries-delete_administrative_level",
        "parameters": [
          {
            "name": "country_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Country Code"
            }
          },
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/countries/{country_code}/institution-types/{institution_type}": {
      "put": {
        "tags": [
          "countries"
        ],
        "summary": "Put Country Institution Type",
        "description": "How the country uses a type: the sources expected for it and what its names look like.",
        "operationId": "countries-put_country_institution_type",
        "parameters": [
          {
            "name": "country_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Country Code"
            }
          },
          {
            "name": "institution_type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Institution Type"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CountryInstitutionTypeInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryInstitutionTypeInput"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "countries"
        ],
        "summary": "Delete Country Institution Type",
        "description": "Refused while one of the country's levels expects the type.",
        "operationId": "countries-delete_country_institution_type",
        "parameters": [
          {
            "name": "country_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Country Code"
            }
          },
          {
            "name": "institution_type",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Institution Type"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/institution-types": {
      "get": {
        "tags": [
          "countries"
        ],
        "summary": "List Institution Types",
        "description": "Global: one `hospital` for every country.",
        "operationId": "countries-list_institution_types",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/InstitutionTypeInput"
                  },
                  "type": "array",
                  "title": "Response Countries-List Institution Types"
                }
              }
            }
          }
        }
      }
    },
    "/institution-types/{name}": {
      "put": {
        "tags": [
          "countries"
        ],
        "summary": "Put Institution Type",
        "description": "Create or change a type; a body with another name renames it everywhere.",
        "operationId": "countries-put_institution_type",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstitutionTypeInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstitutionTypeInput"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "countries"
        ],
        "summary": "Delete Institution Type",
        "description": "Refused while anything refers to the type.",
        "operationId": "countries-delete_institution_type",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/source-types": {
      "get": {
        "tags": [
          "countries"
        ],
        "summary": "List Source Types",
        "operationId": "countries-list_source_types",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/SourceTypeInput"
                  },
                  "type": "array",
                  "title": "Response Countries-List Source Types"
                }
              }
            }
          }
        }
      }
    },
    "/source-types/{name}": {
      "put": {
        "tags": [
          "countries"
        ],
        "summary": "Put Source Type",
        "description": "Create or change a source type; a body with another name renames it everywhere.",
        "operationId": "countries-put_source_type",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SourceTypeInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceTypeInput"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "countries"
        ],
        "summary": "Delete Source Type",
        "description": "Refused while anything refers to the type.",
        "operationId": "countries-delete_source_type",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdministrativeLevelInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Name"
          },
          "rank": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Rank"
          },
          "government_institution_type": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Government Institution Type"
          },
          "expected_institution_types": {
            "items": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "type": "array",
            "title": "Expected Institution Types",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "rank",
          "government_institution_type"
        ],
        "title": "AdministrativeLevelInput"
      },
      "CountryInstitutionTypeInput": {
        "properties": {
          "institution_type": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Institution Type"
          },
          "expected_source_types": {
            "items": {
              "type": "string",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "type": "array",
            "title": "Expected Source Types",
            "default": []
          },
          "name_pattern": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name Pattern"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "institution_type"
        ],
        "title": "CountryInstitutionTypeInput"
      },
      "CountryOutput": {
        "properties": {
          "settings": {
            "$ref": "#/components/schemas/CountrySettingsInput"
          },
          "administrative_levels": {
            "items": {
              "$ref": "#/components/schemas/AdministrativeLevelInput"
            },
            "type": "array",
            "title": "Administrative Levels"
          },
          "institution_types": {
            "items": {
              "$ref": "#/components/schemas/CountryInstitutionTypeInput"
            },
            "type": "array",
            "title": "Institution Types"
          }
        },
        "type": "object",
        "required": [
          "settings",
          "administrative_levels",
          "institution_types"
        ],
        "title": "CountryOutput",
        "description": "One country's five tables, as the console reads them. The global type tables have routes\nof their own."
      },
      "CountrySettingsInput": {
        "properties": {
          "country_code": {
            "type": "string",
            "pattern": "^[A-Z]{2}$",
            "title": "Country Code"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "naming_rules": {
            "$ref": "#/components/schemas/NamingRules",
            "default": {
              "designators": [],
              "connectors": [],
              "leading": [],
              "and_words": []
            }
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "country_code",
          "name"
        ],
        "title": "CountrySettingsInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "InstitutionTypeInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "title": "InstitutionTypeInput"
      },
      "NamingRules": {
        "properties": {
          "designators": {
            "items": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": "array",
            "title": "Designators",
            "default": []
          },
          "connectors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Connectors",
            "default": []
          },
          "leading": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Leading",
            "default": []
          },
          "and_words": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "And Words",
            "default": []
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "NamingRules",
        "description": "How the country writes its public bodies' names, in its languages. A government's name is\na place name with a designator around it (\"Township of Elmwood\", \"Elmwood, Township of\");\nknowing the designators lets the checks find the place name and tell a township from the\ncity of the same name."
      },
      "SourceTypeInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "title": "Name"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "title": "SourceTypeInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
