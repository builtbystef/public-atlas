# Settings for apps/server. Copy to .env; every line here is also the default, so an empty .env
# works for local development.
#
# Each variable is a field of `Settings` in src/public_atlas/config.py, upper-cased with the
# PUBLIC_ATLAS_ prefix. Durations take ISO 8601 ("P7D", "PT15M") or seconds. Deployment values
# only: product data (countries, types, prices, model names) lives in tables and data files.

# --- Logs --------------------------------------------------------------------

# Level for the app's own loggers.
PUBLIC_ATLAS_LOG_LEVEL="INFO"
# "text" (timestamp, level, logger, request ID, message) for a terminal, or "json" (one object
# per line, the same fields) for a log collector. Every line carries the request ID, and the API
# logs one line per request.
PUBLIC_ATLAS_LOG_FORMAT="text"
# Set a Logfire write token to send requests, SQL, jobs and logs to https://logfire.pydantic.dev.
# Unset: telemetry is off. See src/public_atlas/shared/telemetry.py.
# PUBLIC_ATLAS_LOGFIRE_TOKEN=""
# Shown in Logfire to tell deployments apart.
PUBLIC_ATLAS_LOGFIRE_ENVIRONMENT="development"

# --- Database ----------------------------------------------------------------

# The PostgreSQL from compose.yaml (`vp run infra:up`).
PUBLIC_ATLAS_DATABASE_URL="postgresql+psycopg://public_atlas:public_atlas@localhost:5432/public_atlas"
# Log every SQL statement.
PUBLIC_ATLAS_DATABASE_ECHO=false
# Connections each process keeps open, and how many more it may open under load.
PUBLIC_ATLAS_DATABASE_POOL_SIZE=5
PUBLIC_ATLAS_DATABASE_MAX_OVERFLOW=10
# PostgreSQL cancels any statement that runs longer than this.
PUBLIC_ATLAS_DATABASE_STATEMENT_TIMEOUT="PT30S"

# --- Object storage ----------------------------------------------------------

# Snapshots (stored copies of pages and files) and recorded videos. "s3" covers every
# S3-compatible service: the RustFS from compose.yaml locally, Cloudflare R2 hosted. See
# src/public_atlas/integrations/storage.
PUBLIC_ATLAS_STORAGE_PROVIDER="s3"
PUBLIC_ATLAS_STORAGE_BUCKET="public-atlas"
# The RustFS from compose.yaml. For AWS S3 itself set this to null.
#
# Cloudflare R2, for a hosted deployment: create a bucket and an API token with object read and
# write on it, then set
#   PUBLIC_ATLAS_STORAGE_ENDPOINT_URL="https://<account id>.r2.cloudflarestorage.com"
#   PUBLIC_ATLAS_STORAGE_REGION="auto"
#   PUBLIC_ATLAS_STORAGE_ACCESS_KEY=<the token's access key id>
#   PUBLIC_ATLAS_STORAGE_SECRET_KEY=<the token's secret access key>
#   PUBLIC_ATLAS_STORAGE_PATH_STYLE=false
# Presigned download URLs are signed for that endpoint, so leave the public endpoint unset
# unless the console reaches R2 through a custom domain.
PUBLIC_ATLAS_STORAGE_ENDPOINT_URL="http://127.0.0.1:9000"
# Where the browser reaches storage, when that differs from the address above (the API inside
# Docker, the browser outside). Presigned download URLs use it.
# PUBLIC_ATLAS_STORAGE_PUBLIC_ENDPOINT_URL="http://localhost:9000"
# R2 takes "auto".
PUBLIC_ATLAS_STORAGE_REGION="us-east-1"
PUBLIC_ATLAS_STORAGE_ACCESS_KEY="rustfsadmin"
PUBLIC_ATLAS_STORAGE_SECRET_KEY="rustfsadmin"
# true: host/bucket/key URLs (RustFS, MinIO). false: bucket.host/key (AWS, R2).
PUBLIC_ATLAS_STORAGE_PATH_STYLE=true
# How long a presigned download URL stays valid.
PUBLIC_ATLAS_STORAGE_URL_TTL="PT15M"

# --- Official lists ----------------------------------------------------------

# Where `public-atlas load-list` keeps the files it downloads (a census table, a directory),
# each checked against the hash its list module records. Default: ~/.cache/public-atlas/official-lists.
# PUBLIC_ATLAS_LISTS_CACHE_DIR=""

# --- Evals -------------------------------------------------------------------

# The database an eval run builds its graph in, on the same server as the main one; created and
# reset by `public-atlas eval run`. The scores and the cost go to the main database.
PUBLIC_ATLAS_EVAL_DATABASE_NAME=public_atlas_evals

# --- Background jobs ---------------------------------------------------------

# The queue is in the database above (src/public_atlas/jobs); `public-atlas-worker` runs the
# jobs, for every queue or the ones named with `--queues`. How many one worker process runs at
# a time.
PUBLIC_ATLAS_JOBS_CONCURRENCY=2
# A job that failed for good stays in the queue's table, to be looked at, this long.
PUBLIC_ATLAS_PURGE_AFTER="P7D"

# --- Parsing -----------------------------------------------------------------

# "docling" needs the parse-cpu or parse-cu130 dependency group; only the parse worker loads
# the parser's models. "memory" is the test double.
PUBLIC_ATLAS_PARSE_PROVIDER="docling"
# Pages of a PDF per Docling call. Docling holds every page of a call in memory, so a long PDF
# is parsed in ranges of this size. A file whose first attempt killed the worker is retried one
# page per call.
PUBLIC_ATLAS_PARSE_PAGE_BATCH=10
# Per range of pages; a range that runs longer fails the parse.
PUBLIC_ATLAS_PARSE_TIMEOUT="PT3M"
# A PDF with more pages is not parsed; the agent is told why.
PUBLIC_ATLAS_PARSE_MAX_PAGES=500
# After a job, a parse worker whose resident memory has passed this many MB stops and its
# supervisor restarts it: Docling keeps what a heavy page cost.
PUBLIC_ATLAS_PARSE_RETIRE_RSS_MB=4000

# --- Browser -----------------------------------------------------------------

# The agent's Chromium. Install it once on a dev machine with `vp run browser:install`.
# Token cap on what one browser tool call returns to the model.
PUBLIC_ATLAS_BROWSER_MAX_CONTENT_TOKENS=8000
# At least this long between two page loads on one host, across every session the worker runs.
# At one second ontario.ca throttled the network within minutes.
PUBLIC_ATLAS_BROWSER_MIN_INTERVAL="PT3S"
PUBLIC_ATLAS_BROWSER_RESPECT_ROBOTS=true
# Chromium's renderer sandbox. Off only where it cannot start (a container without user
# namespaces).
PUBLIC_ATLAS_BROWSER_CHROMIUM_SANDBOX=true
# Lets the browser reach loopback and private addresses. Only for a test against a fixture
# server; never in a deployment.
PUBLIC_ATLAS_BROWSER_ALLOW_PRIVATE_ADDRESSES=false

# --- Files (the read_file tool) ----------------------------------------------

# 50 MiB.
PUBLIC_ATLAS_READ_FILE_MAX_BYTES=52428800
# Characters of text per chunk returned to the model.
PUBLIC_ATLAS_READ_FILE_CHUNK_CHARS=12000
# How long the tool waits for the parse queue before telling the agent to check `status` later.
PUBLIC_ATLAS_READ_FILE_WAIT="PT90S"
# A file another assignment fetched this recently is read from its snapshot, text included,
# instead of being downloaded and parsed again.
PUBLIC_ATLAS_READ_FILE_REUSE="P1D"

# --- Web search ---------------------------------------------------------------

# "brave" backs the `search` tool of `find_homepage` (needs the key); "none" leaves the tool
# out. Every search is one billed request, priced from
# src/public_atlas/modules/assignments/prices.toml into the `usage` table.
PUBLIC_ATLAS_SEARCH_PROVIDER="none"
# PUBLIC_ATLAS_BRAVE_API_KEY=""

# --- The model ---------------------------------------------------------------

# The OpenAI key the agent's sessions run with (the Responses API). Unset: no assignment can
# run; a worker that picks one up fails the job and the queue retries it later. Which model each
# assignment type uses, how hard it reasons and its budget are product data in
# src/public_atlas/modules/assignments/descriptors.py; the prices are in prices.toml beside it.
# PUBLIC_ATLAS_OPENAI_API_KEY=""

# --- Runs --------------------------------------------------------------------

# A worker that picks up an assignment of a paused run puts the job back for this long.
PUBLIC_ATLAS_PAUSED_RUN_DELAY="PT30S"
# The recorded videos of an assignment are deleted this many days after it finished (its events
# say so), and its events this many days after. Findings, usage and the summary are never purged.
PUBLIC_ATLAS_VIDEO_KEEP_DAYS=7
PUBLIC_ATLAS_EVENTS_KEEP_DAYS=90
