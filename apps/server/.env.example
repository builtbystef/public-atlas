# Settings for apps/server. Copy to .env; every line here is also the default, so an empty .env
# works for local development.
#
# Each variable is a field of `Settings` in src/public_atlas/config.py, upper-cased with the
# PUBLIC_ATLAS_ prefix. Durations take ISO 8601 ("P7D", "PT15M") or seconds. Deployment values
# only: product data (countries, types, prices, model names) lives in tables and data files.

# --- Logs --------------------------------------------------------------------

# Level for the app's own loggers.
PUBLIC_ATLAS_LOG_LEVEL="INFO"
# "text" (timestamp, level, logger, request ID, message) for a terminal, or "json" (one object
# per line, the same fields) for a log collector. Every line carries the request ID, and the API
# logs one line per request.
PUBLIC_ATLAS_LOG_FORMAT="text"
# Set a Logfire write token to send requests, SQL, jobs and logs to https://logfire.pydantic.dev.
# Unset: telemetry is off. See src/public_atlas/shared/telemetry.py.
# PUBLIC_ATLAS_LOGFIRE_TOKEN=""
# Shown in Logfire to tell deployments apart.
PUBLIC_ATLAS_LOGFIRE_ENVIRONMENT="development"

# --- Database ----------------------------------------------------------------

# The PostgreSQL from compose.yaml (`vp run infra:up`).
PUBLIC_ATLAS_DATABASE_URL="postgresql+psycopg://public_atlas:public_atlas@localhost:5432/public_atlas"
# Log every SQL statement.
PUBLIC_ATLAS_DATABASE_ECHO=false
# Connections each process keeps open, and how many more it may open under load.
PUBLIC_ATLAS_DATABASE_POOL_SIZE=5
PUBLIC_ATLAS_DATABASE_MAX_OVERFLOW=10
# PostgreSQL cancels any statement that runs longer than this.
PUBLIC_ATLAS_DATABASE_STATEMENT_TIMEOUT="PT30S"

# --- Object storage ----------------------------------------------------------

# Snapshots (stored copies of pages and files) and recorded videos. "s3" covers every
# S3-compatible service: the RustFS from compose.yaml locally, Cloudflare R2 hosted. See
# src/public_atlas/integrations/storage.
PUBLIC_ATLAS_STORAGE_PROVIDER="s3"
PUBLIC_ATLAS_STORAGE_BUCKET="public-atlas"
# The RustFS from compose.yaml. For AWS S3 itself set this to null; for R2,
# https://<account id>.r2.cloudflarestorage.com.
PUBLIC_ATLAS_STORAGE_ENDPOINT_URL="http://127.0.0.1:9000"
# Where the browser reaches storage, when that differs from the address above (the API inside
# Docker, the browser outside). Presigned download URLs use it.
# PUBLIC_ATLAS_STORAGE_PUBLIC_ENDPOINT_URL="http://localhost:9000"
# R2 takes "auto".
PUBLIC_ATLAS_STORAGE_REGION="us-east-1"
PUBLIC_ATLAS_STORAGE_ACCESS_KEY="rustfsadmin"
PUBLIC_ATLAS_STORAGE_SECRET_KEY="rustfsadmin"
# true: host/bucket/key URLs (RustFS, MinIO). false: bucket.host/key (AWS, R2).
PUBLIC_ATLAS_STORAGE_PATH_STYLE=true
# How long a presigned download URL stays valid.
PUBLIC_ATLAS_STORAGE_URL_TTL="PT15M"

# --- Background jobs ---------------------------------------------------------

# The queue is in the database above (src/public_atlas/jobs); `public-atlas-worker` runs the
# jobs, for every queue or the ones named with `--queues`. How many one worker process runs at
# a time.
PUBLIC_ATLAS_JOBS_CONCURRENCY=2
# A job that failed for good stays in the queue's table, to be looked at, this long.
PUBLIC_ATLAS_PURGE_AFTER="P7D"
